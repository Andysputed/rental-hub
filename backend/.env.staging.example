# Isolated staging configuration. Copy to backend/.env.staging (gitignored).
# Never add production DATABASE_URL or Neon credentials here.
DJANGO_ENV=staging
STAGING_SECRET_KEY=change-me-staging-only
STAGING_DB_NAME=rentalhub_staging
STAGING_DB_USER=staging_admin
STAGING_DB_PASSWORD=
STAGING_DB_HOST=127.0.0.1
STAGING_DB_PORT=55432

ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RENTALHUB_PROPERTY_ID=1

# Used by seed_staging_data when creating/updating the local staging login.
STAGING_LANDLORD_USERNAME=staging_landlord
STAGING_LANDLORD_PASSWORD=StagingLandlord!2026
