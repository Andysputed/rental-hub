# RentalHub Django Backend Configuration
DEBUG=True
SECRET_KEY=rentalhub-insecure-development-key-change-in-production

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Production deployment example (Render API + Vercel frontend)
# ALLOWED_HOSTS=rentalhub-api-0nll.onrender.com
# CORS_ALLOWED_ORIGINS=https://rental-hub-nxaj.vercel.app
# CSRF_TRUSTED_ORIGINS=https://rental-hub-nxaj.vercel.app

# Database configuration
# DATABASE_URL takes precedence over the DB_* settings below when set
# (e.g. Neon's pooled connection string, including sslmode=require).
# DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require
# Set DB_ENGINE to "postgresql" for production or local PostgreSQL
DB_ENGINE=postgresql
DB_NAME=rentalhub
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Timezone & Currency
TIME_ZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES

# Landlord Initial Setup (optional for automated setup_landlord command)
# LANDLORD_USERNAME=admin
# LANDLORD_PASSWORD=change_this_secure_password
