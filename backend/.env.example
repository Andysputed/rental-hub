# RentalHub Django Backend Configuration
DEBUG=True
SECRET_KEY=rentalhub-insecure-development-key-change-in-production

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Database configuration
# Set DB_ENGINE to "postgresql" for production or local PostgreSQL
DB_ENGINE=postgresql
DB_NAME=rentalhub
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Timezone & Currency
TIME_ZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES
